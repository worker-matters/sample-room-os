# Copy to .env.production on the factory computer. Never commit the real file.
COMPOSE_PROJECT_NAME=sample-room-factory
POSTGRES_IMAGE=postgres:16-alpine
SAMPLE_ROOM_APP_IMAGE=sample-room-system-v2:000000000000
SAMPLE_ROOM_TOOLS_IMAGE=sample-room-system-v2-tools:000000000000
FACTORY_LAN_IP=<factory_lan_ip>
FACTORY_DATA_ROOT_HOST=C:/SampleRoomData
SAMPLE_ROOM_STORAGE_ROOT=D:/SampleRoomAttachments
FACTORY_BACKUP_ROOT_HOST=D:/SampleRoomBackups
FACTORY_UPDATE_ROOT=D:/SampleRoomBackups/SystemUpdates
POSTGRES_DB=sample_room_v2
POSTGRES_USER=sample_room
POSTGRES_PASSWORD=generated-during-install
LIFECYCLE_RUNNER_TOKEN=generated-during-install
SAMPLE_ROOM_APP_VERSION=0.1.0
SAMPLE_ROOM_UPDATE_MAX_BYTES=8589934592
SAMPLE_ROOM_HTTP_BIND=0.0.0.0
SAMPLE_ROOM_HTTP_PORT=3001
SAMPLE_ROOM_RUNNER_PORT=3002
PUBLIC_WEB_BASE_URL=
PUBLIC_API_BASE_URL=
SAMPLE_ROOM_TRUST_PROXY=
SAMPLE_ROOM_CORS_ORIGINS=
SAMPLE_ROOM_PUBLIC_HTTPS_HOSTS=
