# Factory-local file only. Copy to .env.factory.local; never commit the real file.
FACTORY_LAN_IP=<factory_lan_ip>
FACTORY_DATA_ROOT_HOST=C:/SampleRoomData
SAMPLE_ROOM_STORAGE_ROOT=D:/SampleRoomAttachments
FACTORY_BACKUP_ROOT_HOST=D:/SampleRoomBackups
FACTORY_UPDATE_ROOT=D:/SampleRoomBackups/SystemUpdates
SAMPLE_ROOM_APP_VERSION=0.1.0
POSTGRES_DB=sample_room_v2
POSTGRES_USER=sample_room
POSTGRES_PASSWORD=replace-with-a-long-random-value
LIFECYCLE_RUNNER_TOKEN=replace-with-an-install-time-random-machine-credential
PUBLIC_WEB_BASE_URL=
PUBLIC_API_BASE_URL=
# Set only after observing the real cpolar proxy socket IP and forwarded
# headers. Never use "true" or an unrestricted wildcard.
SAMPLE_ROOM_TRUST_PROXY=
SAMPLE_ROOM_CORS_ORIGINS=
SAMPLE_ROOM_PUBLIC_HTTPS_HOSTS=
# Default remains 8 GiB; change only after checking disk and backup capacity.
SAMPLE_ROOM_UPDATE_MAX_BYTES=8589934592
