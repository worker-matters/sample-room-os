{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "vitest/globals"]
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts"]
}
