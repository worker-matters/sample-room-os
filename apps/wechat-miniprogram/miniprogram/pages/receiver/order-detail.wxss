.detail-tabs {
  background: #fff;
  border-bottom: 2rpx solid #e4e9ed;
  border-radius: 14rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.detail-tabs view {
  border-bottom: 5rpx solid transparent;
  color: #52606d;
  font-size: 25rpx;
  padding: 22rpx 8rpx 18rpx;
  text-align: center;
}

.detail-tabs .active {
  border-bottom-color: #176b87;
  color: #176b87;
  font-weight: 650;
}

.detail-head { align-items: center; display: grid; gap: 18rpx; grid-template-columns: 120rpx minmax(0, 1fr) auto; }
.detail-head-copy { display: flex; flex-direction: column; min-width: 0; }
.detail-head .hero-image { background: #eef2f4; border-radius: 12rpx; height: 120rpx; width: 120rpx; }
.hero-placeholder { align-items: center; color: #7a8b99; display: flex; font-size: 30rpx; justify-content: center; }
.stage-tag { background: #e7f4f7; border-radius: 999rpx; color: #176b87; flex: 0 0 auto; font-size: 22rpx; padding: 6rpx 12rpx; }
.compact-notice { font-size: 23rpx; padding: 14rpx 18rpx; }
.row .muted { flex: 0 0 210rpx; }
.row text:last-child { flex: 1; text-align: right; word-break: break-all; }

.attachment-row { border-bottom: 2rpx solid #eef1f3; padding: 20rpx 0; }
.attachment-copy text { display: block; }
.attachment-actions { color: #176b87; display: flex; font-size: 24rpx; gap: 20rpx; margin-top: 12rpx; }
.danger-text { color: #a82e2e; }
.charge-row { align-items: flex-start; border-top: 2rpx solid #eef1f3; display: flex; gap: 18rpx; padding: 20rpx 0; }
.charge-main { flex: 1; min-width: 0; }
.charge-title { display: flex; font-weight: 650; justify-content: space-between; margin-bottom: 8rpx; }
.charge-actions { color: #176b87; display: flex; flex-direction: column; font-size: 24rpx; gap: 14rpx; }
.section-heading { align-items: center; display: flex; justify-content: space-between; }
.section-heading .section-title { margin-bottom: 0; }
.section-summary { color: #176b87; font-size: 24rpx; font-weight: 600; }
.scan-row { border-top: 2rpx solid #eef1f3; display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx 0; }
.scan-row > view { align-items: center; display: flex; gap: 12rpx; }
