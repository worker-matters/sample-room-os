@import "../../app.wxss";
.search{margin-bottom:18rpx}.filter-grid{display:grid;gap:12rpx;grid-template-columns:repeat(2,1fr);margin-bottom:18rpx}.filter-grid .picker{font-size:24rpx;min-height:72rpx;overflow:hidden;padding:16rpx 12rpx;text-overflow:ellipsis;white-space:nowrap}.status-filters{display:flex;gap:12rpx;margin-bottom:24rpx}.status-filters view{background:#fff;border:2rpx solid #dce3e8;border-radius:12rpx;color:#52606d;flex:1;font-size:25rpx;padding:15rpx 6rpx;text-align:center}.status-filters .active{background:#176b87;border-color:#176b87;color:#fff}.statement-card{align-items:flex-start;display:flex;padding:26rpx}.statement-icon{align-items:center;background:#edf5f8;border-radius:14rpx;color:#176b87;display:flex;flex:0 0 auto;font-weight:700;height:82rpx;justify-content:center;width:82rpx}.statement-copy{margin-left:20rpx;min-width:0;width:100%}.card-head,.card-foot{align-items:center;display:flex;justify-content:space-between}.status-tag{background:#fff4e8;border-radius:8rpx;color:#a35b16;font-size:22rpx;padding:6rpx 10rpx}.status-tag.paid{background:#e8f6ef;color:#24724b}.status-tag.returned{background:#eef1f3;color:#66737d}.line{font-size:26rpx;line-height:1.65;margin-top:4rpx}.card-foot{border-top:2rpx solid #eef1f3;margin-top:14rpx;padding-top:14rpx}.money{font-weight:700}.arrow{color:#176b87;font-size:42rpx}
