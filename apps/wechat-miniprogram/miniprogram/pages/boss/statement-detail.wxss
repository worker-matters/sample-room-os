@import "../../app.wxss";
.statement-detail-page{padding-bottom:150rpx}.card-head{align-items:flex-start;display:flex;justify-content:space-between}.status-tag{background:#fff4e8;border-radius:8rpx;color:#a35b16;font-size:23rpx;padding:7rpx 12rpx}.status-tag.paid{background:#e8f6ef;color:#24724b}.status-tag.returned{background:#eef1f3;color:#66737d}.total-row{border-top:2rpx solid #eef1f3;font-size:34rpx;font-weight:700;margin-top:22rpx;padding-top:20rpx}.outside-title{margin:10rpx 4rpx 18rpx}.item-title{display:block;font-weight:650}.danger-link{background:#fff;border:2rpx solid #e3574f;color:#b23832;flex:0 0 auto;margin-left:16rpx}.money-grid{display:grid;gap:20rpx 12rpx;grid-template-columns:1fr 1fr;margin-top:22rpx}.money-grid text{display:block;font-size:25rpx;margin-top:6rpx}.money-grid .muted{font-size:23rpx}.subtotal{font-weight:700}.returned-item{opacity:.65}.action-bar{background:#fff;bottom:0;box-shadow:0 -6rpx 22rpx rgba(23,60,90,.08);box-sizing:border-box;display:flex;gap:14rpx;left:0;padding:18rpx 22rpx;position:fixed;width:100%;z-index:3}.action-button{flex:1;font-size:25rpx;margin:0;padding-left:10rpx;padding-right:10rpx}
