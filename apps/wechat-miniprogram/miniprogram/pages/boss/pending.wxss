@import "../../app.wxss";
.pending-page{padding-bottom:150rpx}.search{margin-bottom:18rpx}.filter-grid{display:grid;gap:12rpx;grid-template-columns:repeat(3,1fr);margin-bottom:24rpx}.filter-grid .picker{font-size:24rpx;min-height:72rpx;overflow:hidden;padding:16rpx 12rpx;text-overflow:ellipsis;white-space:nowrap}.pricing-card-main{align-items:flex-start;display:flex;gap:18rpx}.style-thumbnail{background:#edf3f6;border-radius:12rpx;flex:0 0 auto;height:128rpx;width:104rpx}.thumbnail-placeholder{align-items:center;color:#176b87;display:flex;font-size:28rpx;font-weight:700;justify-content:center}.pricing-card-copy{min-width:0;width:100%}.card-head,.card-actions,.bottom-action{align-items:center;display:flex;justify-content:space-between}.status-tag,.task-tag{background:#fff4e8;border-radius:8rpx;color:#a35b16;font-size:23rpx;padding:7rpx 12rpx}.status-tag.done{background:#e8f6ef;color:#24724b}.task-tag{background:#eef3f6;color:#536574}.task-line{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.money{color:#173c5a;font-size:34rpx;font-weight:700}.card-actions{border-top:2rpx solid #edf1f3;margin-top:22rpx;padding-top:18rpx}.select-box{color:#176b87;font-size:25rpx}.select-box.selected{font-weight:650}.select-box.disabled{color:#9aa5ad}.check{border:2rpx solid currentColor;border-radius:5rpx;display:inline-flex;height:30rpx;justify-content:center;margin-right:10rpx;width:30rpx}.link-button{background:#fff;color:#176b87;margin:0}.bottom-action{background:#fff;bottom:0;box-shadow:0 -6rpx 22rpx rgba(23,60,90,.08);box-sizing:border-box;left:0;padding:18rpx 32rpx;position:fixed;width:100%;z-index:2}.create-button{margin:0;min-width:260rpx}
