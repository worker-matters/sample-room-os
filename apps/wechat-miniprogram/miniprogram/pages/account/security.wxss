@import "../../app.wxss";
.security-page{padding-top:28rpx}.success-notice{background:#eef9f2;border-left-color:#2b8a57;color:#246b48}.section-heading{display:block;font-size:31rpx;font-weight:650;margin:4rpx 6rpx 16rpx}.password-heading{margin-top:36rpx}.form-card{background:#fff;border:2rpx solid #dfe6ea;border-radius:14rpx;overflow:hidden}.form-row{align-items:center;display:grid;grid-template-columns:210rpx 1fr;min-height:94rpx;padding:0 24rpx}.form-row+.form-row{border-top:2rpx solid #e6ebee}.form-row>text:first-child{font-size:26rpx}.form-row input{text-align:right}.form-row input::placeholder{color:#a2aab1}.form-row.read-only>text:last-child{text-align:right}.password-row{grid-template-columns:220rpx 1fr}.helper{color:#697786;display:block;font-size:23rpx;line-height:1.55;margin:14rpx 8rpx}.profile-save,.save-button{margin-top:24rpx}.save-button{width:100%}
