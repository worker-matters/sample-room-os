.title,
.description {
  display: block;
}

.title {
  font-size: 38rpx;
  font-weight: 650;
}

.description {
  color: #6c7884;
  line-height: 1.6;
  margin-top: 18rpx;
}

.row {
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  padding: 14rpx 0;
}

.row text:last-child {
  max-width: 68%;
  text-align: right;
}

.action-card {
  padding-bottom: 28rpx;
}

.action-card .field:last-of-type {
  margin-bottom: 0;
}

.compact-textarea {
  min-height: 124rpx;
}

.compact-button,
.action-button {
  margin-top: 0;
}

.compact-button {
  margin-bottom: 12rpx;
}

.action-description {
  margin-top: 0;
}

.photo-row {
  align-items: center;
  border: 2rpx solid #e2e8ec;
  border-radius: 12rpx;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 14rpx;
}

.photo-limit-copy {
  display: block;
  font-size: 23rpx;
  line-height: 1.5;
  margin-bottom: 18rpx;
}

.photo-thumb {
  border-radius: 8rpx;
  flex: 0 0 84rpx;
  height: 84rpx;
  width: 84rpx;
}

.photo-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  font-size: 23rpx;
  min-width: 0;
}

.photo-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-actions {
  color: #176b87;
  display: flex;
  flex-direction: column;
  font-size: 23rpx;
  gap: 12rpx;
}

.danger-text {
  color: #a82e2e;
}

.upload-progress {
  color: #176b87;
  display: block;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  text-align: center;
}
