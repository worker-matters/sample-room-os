@import "../../app.wxss";
.period-tabs{background:#fff;border-radius:12rpx;display:flex;margin-bottom:24rpx;padding:8rpx}.period-tabs view{border-radius:9rpx;flex:1;font-size:25rpx;padding:18rpx 6rpx;text-align:center}.period-tabs .active{background:#176b87;color:#fff}.custom-range{align-items:center;display:grid;gap:10rpx;grid-template-columns:1fr auto 1fr auto;margin-bottom:22rpx}.custom-range .picker{font-size:23rpx;min-height:68rpx;padding:14rpx 10rpx}.range-button{background:#176b87;color:#fff}.position-line{display:block;margin:12rpx 4rpx 20rpx}.metric-card{display:grid;grid-template-columns:repeat(4,1fr);padding:28rpx 8rpx;text-align:center}.metric-card>view+view{border-left:2rpx solid #e7ecef}.metric-label{color:#5f6c77;display:block;font-size:22rpx}.metric-value{color:#0f5675;display:block;font-size:34rpx;font-weight:700;margin-top:12rpx}.quality-card{display:grid;grid-template-columns:1fr 1fr;padding:26rpx 12rpx;text-align:center}.quality-card>view+view{border-left:2rpx solid #e7ecef}.quality-value{color:#0f5675;display:block;font-size:38rpx;font-weight:700;margin-top:10rpx}.records-title{margin:6rpx 4rpx 14rpx}.record-table{background:#fff;border:2rpx solid #e0e6ea;border-radius:14rpx;overflow:hidden}.record-row{align-items:center;border-top:2rpx solid #e7ecef;display:grid;font-size:22rpx;padding:18rpx 10rpx;text-align:center}.record-row-four{grid-template-columns:1.05fr 1.8fr .75fr .8fr}.record-row-five{grid-template-columns:1fr 1.55fr .62fr .7fr .7fr}.record-head{background:#f7f9fa;border-top:0;color:#53616e}.style-cell{min-width:0}.style-no,.style-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.style-no{color:#263746;font-weight:650}.style-name{color:#7a8790;font-size:20rpx;margin-top:3rpx}.complaint-value{color:#b33d3d;font-weight:650}.compact-empty{padding:28rpx}
