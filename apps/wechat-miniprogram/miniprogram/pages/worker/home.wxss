@import "../../app.wxss";
.worker-home{padding-top:34rpx}.profile-row{align-items:center;display:flex;margin:0 14rpx 34rpx}.avatar{align-items:center;background:#e7eef4;border-radius:50%;color:#7ea1bc;display:flex;height:92rpx;justify-content:center;overflow:hidden;width:92rpx}.avatar text{font-size:74rpx;transform:translateY(22rpx)}.profile-row .identity-name{margin-left:22rpx}.role-badge{background:#e9f5f8;border:2rpx solid #b9dce7;border-radius:8rpx;color:#176b87;font-size:23rpx;margin-left:14rpx;padding:5rpx 10rpx}.scan-entry{align-items:center;background:#087594;border-radius:16rpx;box-shadow:0 8rpx 24rpx rgba(8,117,148,.2);color:#fff;display:flex;margin-bottom:34rpx;min-height:170rpx;padding:20rpx 28rpx}.scan-icon{height:84rpx;position:relative;width:84rpx}.scan-icon text{border-color:#fff;border-style:solid;height:25rpx;position:absolute;width:25rpx}.scan-icon text:nth-child(1){border-width:5rpx 0 0 5rpx;left:0;top:0}.scan-icon text:nth-child(2){border-width:5rpx 5rpx 0 0;right:0;top:0}.scan-icon text:nth-child(3){border-width:0 0 5rpx 5rpx;bottom:0;left:0}.scan-icon text:nth-child(4){border-width:0 5rpx 5rpx 0;bottom:0;right:0}.scan-copy{margin-left:24rpx}.scan-title{display:block;font-size:34rpx;font-weight:650}.scan-description{display:block;font-size:24rpx;margin-top:10rpx}.scan-arrow{font-size:54rpx;margin-left:auto}.menu-card{background:#fff;border:2rpx solid #e1e7eb;border-radius:16rpx;box-shadow:0 5rpx 18rpx rgba(23,60,90,.05)}.menu-row{align-items:center;display:flex;min-height:116rpx;padding:20rpx 26rpx}.menu-row+.menu-row{border-top:2rpx solid #e7ecef}.menu-icon{color:#176b87;font-size:48rpx;width:70rpx}.menu-copy{flex:1}.logout-button{background:transparent;color:#6c7884;font-size:27rpx;margin-top:30rpx}
