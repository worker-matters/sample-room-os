<test-mode-return />
<view class="page performance-page">
  <view class="period-tabs">
    <view class="{{period === 'week' ? 'active' : ''}}" data-period="week" bindtap="changePeriod">本周</view>
    <view class="{{period === 'month' ? 'active' : ''}}" data-period="month" bindtap="changePeriod">本月</view>
    <view class="{{period === 'threeMonths' ? 'active' : ''}}" data-period="threeMonths" bindtap="changePeriod">近三个月</view>
    <view class="{{period === 'custom' ? 'active' : ''}}" data-period="custom" bindtap="changePeriod">自定义</view>
  </view>
  <view class="custom-range" wx:if="{{period === 'custom'}}">
    <picker mode="date" value="{{dateFrom}}" data-field="dateFrom" bindchange="changeDate"><view class="picker">{{dateFrom}}</view></picker>
    <text>至</text>
    <picker mode="date" value="{{dateTo}}" data-field="dateTo" bindchange="changeDate"><view class="picker">{{dateTo}}</view></picker>
    <button size="mini" class="range-button" bindtap="applyCustomRange">查询</button>
  </view>
  <view class="notice error-notice" wx:if="{{message}}">{{message}}</view>

  <block wx:if="{{report}}">
    <text class="position-line">当前岗位：{{workerLabel}}</text>

    <view class="metric-card card" wx:if="{{workerType !== 'qc_delivery'}}">
      <view><text class="metric-label">完成订单</text><text class="metric-value">{{report.summary.completedOrders}}</text></view>
      <view><text class="metric-label">完成件数</text><text class="metric-value">{{report.summary.completedPieces}}</text></view>
      <view><text class="metric-label">记录工时</text><text class="metric-value">{{report.summary.totalHours}}</text></view>
      <view><text class="metric-label">件 / 小时</text><text class="metric-value">{{hourlyOutput}}</text></view>
    </view>

    <view class="metric-card card" wx:else>
      <view><text class="metric-label">完成订单</text><text class="metric-value">{{report.summary.completedOrders}}</text></view>
      <view><text class="metric-label">实收核对件数</text><text class="metric-value">{{report.summary.checkedPieces || 0}}</text></view>
      <view><text class="metric-label">客诉订单</text><text class="metric-value">{{report.summary.complaintOrders || 0}}</text></view>
      <view><text class="metric-label">客诉比例</text><text class="metric-value">{{complaintRate}}%</text></view>
    </view>

    <view class="quality-card card" wx:if="{{workerType === 'sewing'}}">
      <view><text class="metric-label">平均组检评分</text><text class="quality-value">{{averageQualityScore}}</text></view>
      <view><text class="metric-label">未评分订单</text><text class="quality-value">{{unratedOrders}}</text></view>
    </view>

    <text class="section-title records-title">最近生产记录</text>
    <view class="record-table">
      <block wx:if="{{workerType === 'cutting'}}">
        <view class="record-row record-row-four record-head"><text>日期</text><text>款式 / 款号</text><text>件数</text><text>工时</text></view>
        <view class="record-row record-row-four" wx:for="{{records}}" wx:key="completedAt">
          <text>{{item.completedDate}}</text>
          <view class="style-cell"><text class="style-no">{{item.styleNo}}</text><text class="style-name">{{item.styleName}}</text></view>
          <text>{{item.pieces || 0}}</text><text>{{item.workHours || 0}}</text>
        </view>
      </block>
      <block wx:elif="{{workerType === 'sewing'}}">
        <view class="record-row record-row-five record-head"><text>日期</text><text>款式 / 款号</text><text>件数</text><text>工时</text><text>评分</text></view>
        <view class="record-row record-row-five" wx:for="{{records}}" wx:key="completedAt">
          <text>{{item.completedDate}}</text>
          <view class="style-cell"><text class="style-no">{{item.styleNo}}</text><text class="style-name">{{item.styleName}}</text></view>
          <text>{{item.pieces || 0}}</text><text>{{item.workHours || 0}}</text><text>{{item.qualityScoreLabel}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="record-row record-row-four record-head"><text>日期</text><text>款式 / 款号</text><text>核对件数</text><text>客诉</text></view>
        <view class="record-row record-row-four" wx:for="{{records}}" wx:key="completedAt">
          <text>{{item.completedDate}}</text>
          <view class="style-cell"><text class="style-no">{{item.styleNo}}</text><text class="style-name">{{item.styleName}}</text></view>
          <text>{{item.pieces || 0}}</text><text class="{{item.complaintCount > 0 ? 'complaint-value' : ''}}">{{item.complaintLabel}}</text>
        </view>
      </block>
      <view class="empty compact-empty" wx:if="{{!records.length}}">当前时间范围暂无完成记录</view>
    </view>
  </block>
  <view class="empty" wx:if="{{loading && !report}}">正在加载绩效…</view>
</view>
