@import "../../app.wxss";
@import "./client-shared.wxss";
.stat-row {
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(23, 60, 90, 0.08);
  display: grid;
  gap: 12rpx;
  grid-template-columns: 1.2fr 0.8fr 1fr 1fr 24rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
}
.stat-name { font-size: 29rpx; font-weight: 600; }
.stat-row view { display: flex; flex-direction: column; gap: 5rpx; text-align: center; }
.stat-number { font-size: 30rpx; font-weight: 600; }
.stat-arrow { color: #8b9299; font-size: 42rpx; }
