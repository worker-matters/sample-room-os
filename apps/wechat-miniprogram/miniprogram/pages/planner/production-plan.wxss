@import "./orders.wxss";
.sewing-grid { background: #f5f8fa; border-radius: 10rpx; display: grid; gap: 12rpx; grid-template-columns: 1fr 1fr; margin-top: 16rpx; padding: 14rpx; }
.sewing-grid view { display: flex; flex-direction: column; font-size: 24rpx; gap: 3rpx; }
.sewing-grid view:last-child { grid-column: 1 / -1; }
