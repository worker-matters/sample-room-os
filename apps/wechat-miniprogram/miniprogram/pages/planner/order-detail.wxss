.detail-tabs {
  background: #fff;
  border-bottom: 2rpx solid #e4e9ed;
  border-radius: 14rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.detail-tabs view {
  border-bottom: 5rpx solid transparent;
  color: #52606d;
  font-size: 23rpx;
  padding: 22rpx 4rpx 18rpx;
  text-align: center;
}

.detail-tabs .active {
  border-bottom-color: #176b87;
  color: #176b87;
  font-weight: 650;
}

.detail-head { align-items: center; display: grid; gap: 18rpx; grid-template-columns: 120rpx minmax(0, 1fr) auto; }
.detail-head-copy { display: flex; flex-direction: column; min-width: 0; }
.detail-head .hero-image { background: #eef2f4; border-radius: 12rpx; height: 120rpx; margin: 0; width: 120rpx; }
.compact-notice { font-size: 23rpx; padding: 14rpx 18rpx; }
.row .muted { flex: 0 0 210rpx; }
.row text:last-child { flex: 1; text-align: right; word-break: break-all; }
.progress-block { align-items: center; border-bottom: 2rpx solid #eef1f3; display: flex; justify-content: space-between; padding: 16rpx 0; }
.progress-value { font-weight: 600; max-width: 68%; text-align: right; }
.material-grid { display: grid; gap: 16rpx; grid-template-columns: 1fr 1fr; margin-top: 20rpx; }
.material-grid view { background: #f5f8fa; border-radius: 10rpx; display: flex; flex-direction: column; gap: 6rpx; padding: 18rpx; }
.file-row { align-items: center; border-top: 2rpx solid #eef1f3; display: flex; gap: 18rpx; padding: 20rpx 0; }
.file-copy { display: flex; flex: 1; flex-direction: column; font-size: 25rpx; gap: 5rpx; min-width: 0; }
.file-copy text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.attachment-subsection { border-top: 2rpx solid #eef1f3; margin-top: 20rpx; padding-top: 20rpx; }
.section-heading { align-items: center; display: flex; justify-content: space-between; }
.section-heading .section-title { margin-bottom: 0; }
.section-summary { color: #176b87; font-size: 24rpx; font-weight: 600; }
.file-action { color: #176b87; font-size: 25rpx; }
.file-buttons { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: flex-end; }
.file-action.danger { color: #a82e2e; }
.compact-empty { padding: 20rpx 0; }
.scan-row { border-top: 2rpx solid #eef1f3; display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 0; }
.scan-row view { align-items: center; display: flex; gap: 12rpx; }
.stage-tag { background: #e7f4f7; border-radius: 999rpx; color: #176b87; font-size: 22rpx; padding: 6rpx 12rpx; }
.charge-row { align-items: flex-start; border-top: 2rpx solid #eef1f3; display: flex; gap: 18rpx; padding: 20rpx 0; }
.charge-main { flex: 1; min-width: 0; }
.charge-title { display: flex; font-weight: 650; justify-content: space-between; margin-bottom: 8rpx; }
.charge-actions { color: #176b87; display: flex; flex-direction: column; font-size: 24rpx; gap: 14rpx; }
.charge-actions .danger { color: #a82e2e; }
