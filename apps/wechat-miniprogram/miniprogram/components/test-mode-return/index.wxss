.test-mode-return {
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #c24444;
  border-radius: 999rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 8rpx 24rpx rgba(23, 50, 77, 0.16);
  color: #a82e2e;
  font-size: 24rpx;
  line-height: 1;
  margin: 0;
  min-width: 210rpx;
  padding: 22rpx 28rpx;
  position: fixed;
  right: 20rpx;
  z-index: 1000;
}
