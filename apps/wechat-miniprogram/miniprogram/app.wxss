page {
  background: #f3f6f8;
  color: #17212b;
  font-size: 30rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(23, 50, 77, 0.08);
  margin-bottom: 28rpx;
  padding: 32rpx;
}

.primary-button {
  background: #176b87;
  border-radius: 14rpx;
  color: #ffffff;
  margin-top: 32rpx;
}

.muted {
  color: #6c7884;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.35;
}

.subtitle {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}

.description {
  color: #6c7884;
  display: block;
  line-height: 1.65;
  margin-top: 12rpx;
}

.row {
  align-items: flex-start;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  line-height: 1.55;
  margin-top: 14rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.input,
.picker,
.textarea {
  background: #f5f7f9;
  border: 2rpx solid #dce3e8;
  border-radius: 12rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  width: 100%;
}

.textarea {
  min-height: 168rpx;
}

.secondary-button {
  background: #ffffff;
  border: 2rpx solid #176b87;
  border-radius: 14rpx;
  color: #176b87;
  margin-top: 20rpx;
}

.danger-button {
  background: #ffffff;
  border: 2rpx solid #c24444;
  border-radius: 14rpx;
  color: #a82e2e;
  margin-top: 20rpx;
}

.notice {
  background: #edf7fb;
  border-left: 8rpx solid #176b87;
  border-radius: 10rpx;
  color: #375466;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
}

.error-notice {
  background: #fff1f0;
  border-left-color: #c24444;
  color: #8b2d2a;
}

.empty {
  color: #7b8790;
  padding: 48rpx 20rpx;
  text-align: center;
}

.identity-card {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.identity-name {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
}

.account-button {
  background: #ffffff;
  border: 2rpx solid #d2dae1;
  color: #52606d;
  flex: 0 0 auto;
  margin: 0 0 0 20rpx;
}

.entry-card {
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(23, 60, 90, 0.08);
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  min-height: 108rpx;
  padding: 26rpx 30rpx;
}

.entry-title { display: block; font-size: 32rpx; font-weight: 650; }
.entry-description { color: #74808f; display: block; font-size: 25rpx; margin-top: 7rpx; }
.entry-arrow { color: #176b87; font-size: 52rpx; font-weight: 300; line-height: 1; }
