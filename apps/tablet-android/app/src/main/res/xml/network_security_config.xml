<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Runtime code permits cleartext only for a scanned, health-verified RFC1918 LAN origin. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
