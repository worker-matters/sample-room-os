NODE_ENV=production
PORT=3001

# Formal login is required for Oray/FRP public Web/API trials.
AUTH_MODE=formal
VITE_AUTH_MODE=formal
VITE_ENABLE_DEV_ENTRY=false

# Oray/FRP trial persistence uses Prisma + PostgreSQL.
# Use a local or factory-LAN PostgreSQL endpoint. Never expose the database port through Oray/FRP.
PERSISTENCE_MODE=prisma
DATABASE_URL=postgresql://<db_user>:<db_password>@127.0.0.1:5432/<db_name>?schema=public

SAMPLE_ROOM_WEB_DIST_ROOT=<optional_web_dist_root>
SAMPLE_ROOM_STORAGE_ROOT=<factory_server_storage_root>
SAMPLE_ROOM_ORDERS_ROOT=<factory_server_orders_root>
SAMPLE_ROOM_LOCAL_FILE_ROOT=<factory_server_local_file_root>
SAMPLE_ROOM_ORDER_FOLDER_ROOT=<factory_server_order_folder_root>
SAMPLE_ROOM_CUTTING_INBOX_ROOT=<factory_server_cutting_inbox_root>
SAMPLE_ROOM_PUBLIC_BASE_URL=https://<oray_or_frp_public_host>
# Preferred explicit fallbacks. System Owner may override these four non-secret
# origins through the persisted runtime-address maintenance page.
SAMPLE_ROOM_PUBLIC_WEB_BASE_URL=https://<public_web_host>
SAMPLE_ROOM_LAN_WEB_BASE_URL=http://<factory_lan_ip>:5173
SAMPLE_ROOM_PUBLIC_API_BASE_URL=https://<public_api_host>
SAMPLE_ROOM_LAN_API_BASE_URL=http://<factory_lan_ip>:3001

# Oray/FRP only maps Web/API to 127.0.0.1:3001.
# Do not expose PostgreSQL, SMB, RDP, SSH, or WinRM through Oray/FRP.
